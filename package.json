{
  "name": "@kaipi/sqlite-fts",
  "version": "0.1.0",
  "description": "SQLite FTS5 search engine with optional GCS sync, HTTP server, and client",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaipi/sqlite-fts.git"
  },
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.9.2"
}
